{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.0",
  "description": "Right-click any link and scan it with PhishGuard.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:10000/*",
    "https://phishguard-7q7y.onrender.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "PhishGuard",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}